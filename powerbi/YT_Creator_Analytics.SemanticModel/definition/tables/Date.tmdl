		summarizeBy: none
		sourceColumn: [Date]

	column Year = YEAR('Date'[Date])
		dataType: int64
		formatString: 0
		lineageTag: 960f8f87-a92d-5d5b-86a2-4280bfa3fc2c
		summarizeBy: none

	column 'Month No' = MONTH('Date'[Date])
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e3bfee74-ebda-5dc3-ba20-2518e943c7fe
		summarizeBy: none

	column Month = FORMAT('Date'[Date], "MMM")
		dataType: string
		lineageTag: 5b624795-a7f6-5cf7-a597-2b1ba92e1768
		summarizeBy: none
		sortByColumn: 'Month No'

	column Year-Month = FORMAT('Date'[Date], "yyyy-MM")
		dataType: string
		lineageTag: 7609b0aa-23b8-540c-93a6-d4ecba7365d5
		summarizeBy: none

	column 'Weekday No' = WEEKDAY('Date'[Date], 2)
		dataType: int64
